# -------- Base image --------
FROM maven:3.9.6-eclipse-temurin-21 AS dev

# Set working directory
WORKDIR /app

# Copy only pom.xml first to leverage Maven cache
COPY pom.xml .

# Pre-download dependencies (speeds up builds)
RUN mvn dependency:go-offline

# Copy everything else
COPY ./src ./src

# Expose default Spring Boot port
EXPOSE 8080

# Use Spring Boot devtools for hot reload
ENV SPRING_DEVTOOLS_RESTART_ENABLED=true
ENV SPRING_PROFILES_ACTIVE=sqlite

# Set the SQLite DB path inside container
ENV SPRING_DATASOURCE_URL=jdbc:sqlite:/data/app.db

# Start the app in dev mode using Maven (hot reload enabled)
CMD ["mvn", "spring-boot:run", "-Dspring-boot.run.profiles=sqlite"]
